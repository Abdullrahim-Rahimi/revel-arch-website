---
// Native disclosure: answers are in the HTML for crawlers and no-JS visitors.
import Ph from './Ph.astro';
interface Props { items: { q: string; a: string }[]; placeholder?: boolean }
const { items, placeholder = false } = Astro.props;
---
<div class="faq">
  {items.map((it) => (
    <details>
      <summary>{it.q}</summary>
      <Ph as="p" when={placeholder}>{it.a}</Ph>
    </details>
  ))}
</div>

<style>
  .faq { border-block-start: 1px solid var(--line); }
  details { border-block-end: 1px solid var(--line); }
  summary {
    cursor: pointer; list-style: none; padding-block: var(--space-s); padding-inline-end: 2rem;
    position: relative; font-size: var(--step-0); color: var(--text);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; position: absolute; inset-inline-end: 0.25rem; inset-block-start: var(--space-s);
    color: var(--accent-text); transition: transform 0.2s var(--ease);
  }
  details[open] summary::after { transform: rotate(45deg); }
  details :global(p) { color: var(--muted); padding-block-end: var(--space-s); }
</style>
