---
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { t } from '../i18n/utils';
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{t('en', 'notFound.title')} · {t('ar', 'notFound.title')}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      .nf { min-block-size: 100vh; display: grid; place-content: center; gap: 2.5rem; padding: 2rem; }
      .nf svg { inline-size: 8rem; }
      .nf .cols { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
      .nf h1 { font-size: var(--step-3); }
    </style>
  </head>
  <body>
    <main class="nf container">
      <a href="/en/" aria-label="Revēl Architecture"><Logo /></a>
      <div class="cols">
        <section lang="en" dir="ltr">
          <h1>{t('en', 'notFound.title')}</h1>
          <p class="muted">{t('en', 'notFound.body')}</p>
          <a class="btn btn-ghost" href="/en/">{t('en', 'notFound.home')}</a>
        </section>
        <section lang="ar" dir="rtl">
          <h2 style="font-size: var(--step-3)">{t('ar', 'notFound.title')}</h2>
          <p class="muted">{t('ar', 'notFound.body')}</p>
          <a class="btn btn-ghost" href="/ar/">{t('ar', 'notFound.home')}</a>
        </section>
      </div>
    </main>
  </body>
</html>
