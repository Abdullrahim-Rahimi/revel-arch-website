---
// Root: sends visitors to their language. Works without JavaScript via the two links.
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { siteConfig } from '../site.config';
const abs = (p: string) => new URL(p, siteConfig.url).href;
---
<!doctype html>
<html lang="en" dir="ltr" data-env={siteConfig.deployEnv}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d1e25" />
    <title>Revēl Architecture · ريفيل للعمارة</title>
    <meta name="description" content="Revēl Architecture, Kuwait. Choose English or Arabic. ريفيل للعمارة، الكويت. اختر اللغة." />
    <meta name="robots" content={siteConfig.deployEnv === 'preview' ? 'noindex,nofollow' : 'noindex,follow'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={abs('/en/')} />
    <link rel="alternate" hreflang="ar" href={abs('/ar/')} />
    <link rel="alternate" hreflang="x-default" href={abs('/en/')} />
    <script is:inline>
      (function () {
        var l = (navigator.languages && navigator.languages[0]) || navigator.language || 'en';
        location.replace(/^ar\b/i.test(l) ? '/ar/' : '/en/');
      })();
    </script>
    <style>
      .chooser { min-block-size: 100vh; display: grid; place-content: center; gap: 2rem; text-align: center; }
      .chooser svg { inline-size: 9rem; margin-inline: auto; }
      .chooser .links { display: flex; gap: 1rem; justify-content: center; }
    </style>
  </head>
  <body>
    <main class="chooser">
      <Logo />
      <p class="muted">Choose your language · <span lang="ar">اختر اللغة</span></p>
      <div class="links">
        <a class="btn btn-ghost" href="/en/" hreflang="en" lang="en">English</a>
        <a class="btn btn-ghost" href="/ar/" hreflang="ar" lang="ar">العربية</a>
      </div>
    </main>
  </body>
</html>
