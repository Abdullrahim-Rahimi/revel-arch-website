---
// Recreation of the "rvēl" wordmark: thin rounded grey strokes, the macron (ē) as a green bar.
// Replace with the owner's vector logo when supplied (questionnaire 6.1).
interface Props { title?: string; class?: string }
const { title = 'Revēl Architecture', class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 250 100" role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <title>{title}</title>
  <g fill="none" stroke="#8a8a8f" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M18 88 V48 Q18 30 36 30" />
    <path d="M70 30 L96 88 L122 30" />
    <path d="M214 22 V72 Q214 88 230 88" />
  </g>
  <polygon points="152,30 194,30 189,40 147,40" fill="#0d6b55" />
</svg>
