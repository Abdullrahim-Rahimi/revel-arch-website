---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { localizedPath, t, type Lang } from '../i18n/utils';
interface Props {
  lang: Lang;
  slug: string;
  title: string;
  type: 'villa' | 'chalet' | 'commercial';
  location: string;
  cover: ImageMetadata;
  coverAlt: string;
  isRender: boolean;
  eager?: boolean;
}
const { lang, slug, title, type, location, cover, coverAlt, isRender, eager = false } = Astro.props;
---
<article class="project-card" data-project-card data-type={type}>
  <a href={localizedPath(lang, `/projects/${slug}/`)}>
    <div class="media">
      <Picture
        src={cover}
        alt={coverAlt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      {isRender && <span class="tag">{t(lang, 'projects.render')}</span>}
    </div>
    <p class="meta">{t(lang, `projects.type.${type}`)} · {location}</p>
    <h3>{title}</h3>
  </a>
</article>

<style>
  .project-card a { display: block; color: inherit; text-decoration: none; }
  .media { position: relative; overflow: hidden; aspect-ratio: 3 / 2; background: var(--surface); }
  .media :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .project-card a:hover .media :global(img) { transform: scale(1.03); }
  .tag {
    position: absolute; inset-block-start: 0.75rem; inset-inline-start: 0.75rem;
    padding: 0.2rem 0.6rem; font-size: var(--step--1); background: rgb(29 30 37 / 0.8); color: var(--text); border-radius: 999px;
  }
  .meta { margin: var(--space-s) 0 0.25rem; font-size: var(--step--1); color: var(--muted); letter-spacing: 0.06em; }
  h3 { margin: 0; font-size: var(--step-1); }
  .project-card a:hover h3 { color: var(--accent-text); }
</style>
